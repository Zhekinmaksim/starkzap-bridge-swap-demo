# TESTNET ONLY.
# This demo keeps a Starknet private key in a browser bundle for speed.
# Never use a production wallet or real funds here.

VITE_PRIVATE_KEY=0xYOUR_STARKNET_SEPOLIA_PRIVATE_KEY
VITE_STARKNET_NETWORK=sepolia

# Optional: improves Ethereum Sepolia bridge fee estimates.
VITE_ETHEREUM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional: sponsored mode depends on a working paymaster endpoint.
# If you do not have one, the app can still run with feeMode="user_pays".
VITE_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi

# Optional default recipient for the batch demo.
VITE_RECIPIENT=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
